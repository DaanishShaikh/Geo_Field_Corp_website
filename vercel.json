{
  "framework": null,
  "buildCommand": "cd frontend && rm -rf node_modules && npm install --foreground-scripts && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "pip install --break-system-packages -r requirements.txt",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
